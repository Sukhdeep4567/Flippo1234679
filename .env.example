# Enquiry form email delivery (optional).
# When both are set, submissions are emailed through Resend (https://resend.com).
# When either is missing, submissions are logged on the server and the form still succeeds.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@flipoteam.com
# Verified sender on your Resend domain. Defaults to onboarding@resend.dev if empty.
CONTACT_FROM_EMAIL=
